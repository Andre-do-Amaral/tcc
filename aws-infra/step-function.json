{
  "Comment": "Pipeline completo de ETL -> MLflow -> Treino -> Promocao -> Predicoes",
  "StartAt": "StartMlflow",
  "States": {
    "StartMlflow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask",
      "Parameters": {
        "Cluster": "arn:aws:ecs:us-east-1:542660891168:cluster/tcc-grupo-10-cluster",
        "TaskDefinition": "arn:aws:ecs:us-east-1:542660891168:task-definition/tcc-grupo10-mlflow",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-00ee6c7313660c248",
              "subnet-0759dbcc8f29613ac",
              "subnet-0a98b89a7d445d828",
              "subnet-075c65bbb9c01ca49",
              "subnet-0e27a76bbdcea06a3",
              "subnet-0d75d35870cb0907c"
            ],
            "AssignPublicIp": "ENABLED"
          }
        }
      },
      "ResultPath": "$.mlflowTask",
      "Next": "ExtractData"
    },
    "ExtractData": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:542660891168:function:tcc-grupo10-data-ingestion-function:$LATEST"
      },
      "Next": "TrainAndUpdateAutoRegressiveModel"
    },
    "TrainAndUpdateAutoRegressiveModel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LambdaTrainModel",
        "Payload": {
          "mlflow_url": "mflow-alb-803063909.us-east-1.elb.amazonaws.com",
          "training_input": "s3://tcc-grupo10-mba-raw/"
        }
      },
      "ResultPath": "$.trainingResult",
      "Next": "PromoteModel"
    },
    "PromoteModel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LambdaPromoteModel",
        "Payload": {
          "trainingResult.$": "$.trainingResult"
        }
      },
      "ResultPath": "$.promotedModel",
      "Next": "GeneratePredictions"
    },
    "GeneratePredictions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LambdaGeneratePredictions",
        "Payload": {
          "model.$": "$.promotedModel"
        }
      },
      "ResultPath": "$.predictions",
      "Next": "StopMlflow"
    },
    "StopMlflow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ecs:stopTask",
      "Parameters": {
        "Cluster": "arn:aws:ecs:us-east-1:542660891168:cluster/tcc-grupo-10-cluster",
        "Task.$": "$.mlflowTask.Tasks[0].TaskArn"
      },
      "End": true
    }
  }
}